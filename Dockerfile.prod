# =========================================================================
# STAGE 1: Build React App (Node.js)
# Menjalankan 'npm run build' untuk menghasilkan file statis di folder /app/dist
# =========================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package.json dan package-lock.json terlebih dahulu untuk memanfaatkan Docker cache
COPY package*.json ./

# Install seluruh dependencies
RUN npm install

# Copy seluruh source code
COPY . .

# Build aplikasi React (output: /app/dist)
RUN npm run build

# =========================================================================
# STAGE 2: Serve dengan Nginx (Web Server Ringan untuk Production)
# Menggunakan Nginx Alpine (~25MB) untuk melayani file statis hasil build
# =========================================================================
FROM nginx:alpine

# Hapus konfigurasi default Nginx
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copy konfigurasi Nginx dengan aturan try_files (pengganti .htaccess mod_rewrite)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy folder 'dist' hasil build dari STAGE 1 ke folder root web server Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port HTTP
EXPOSE 80

# Jalankan Nginx di foreground
CMD ["nginx", "-g", "daemon off;"]
