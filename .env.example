VITE_APP_NAME="FlowGIS"

# Backend Laravel Business Process API
VITE_API_BASE_URL=http://localhost:8001/api

# GeoServer WMS Service URL (untuk layer basemap / katalog spasial)
VITE_GEOSERVER_WMS_URL=http://localhost:8080/geoserver/wms

# AstraGIS Spatial Infrastructure (FastAPI Engine)
VITE_ASTRAGIS_API_URL=http://localhost:8000

# Keycloak SSO OIDC Configuration
VITE_KEYCLOAK_AUTHORITY=http://localhost:8081/realms/wefgis
VITE_KEYCLOAK_CLIENT_ID=flowgis
VITE_KEYCLOAK_REDIRECT_URI=http://localhost:5174/auth/callback
VITE_KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:5170
VITE_PORTAL_URL=http://localhost:5170
VITE_AUTH_LOCAL_ENABLED=false
VITE_LEGACY_LOGIN_ENABLED=false
